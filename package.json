{
  "name": "saucedemo-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "BDD end-to-end UI automation for SauceDemo using WebdriverIO, TypeScript, Cucumber, and POM.",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:bdd": "wdio run wdio.conf.ts",
    "test:checkout": "wdio run wdio.conf.ts --spec features/checkout.feature",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.20.0",
    "@wdio/cucumber-framework": "^9.20.0",
    "@wdio/globals": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.43.0",
    "expect-webdriverio": "^6.0.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "webdriverio": "^9.20.0"
  }
}
